<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>????</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/minimal-ui.css') }}">
    <style>
        .search-form {
            background: var(--bg-secondary);
            padding: var(--spacing-lg);
            margin-bottom: var(--spacing-lg);
            border: var(--border-width) solid var(--border-color);
        }
        
        .results-section {
            margin-top: var(--spacing-lg);
        }
        
        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-md);
        }
        
        .results-count {
            color: var(--text-secondary);
        }
        
        .btn-search {
            background: var(--accent-color);
            color: var(--bg-primary);
            border-color: var(--accent-color);
        }
        
        .btn-search:hover {
            background: var(--accent-hover);
            border-color: var(--accent-hover);
        }
        
        .btn-clear {
            background: var(--bg-primary);
            color: var(--text-primary);
            border-color: var(--border-color);
        }
        
        .btn-export {
            background: var(--accent-color);
            color: var(--bg-primary);
            border-color: var(--accent-color);
        }
        
        .btn-export:hover {
            background: var(--accent-hover);
            border-color: var(--accent-hover);
        }
        
        .results-table {
            border: var(--border-width) solid var(--border-color);
        }
        
        .results-table thead {
            background: var(--bg-secondary);
        }
        
        .results-table th {
            padding: var(--spacing-sm) var(--spacing-md);
            font-weight: 400;
        }
        
        /* ???? */
        .results-table th:nth-child(1) { width: 80px; }  /* ???ID */
        .results-table th:nth-child(2) { width: 100px; } /* ?? */
        .results-table th:nth-child(3) { width: 90px; }  /* ?? */
        .results-table th:nth-child(4) { width: 90px; }  /* ???? */
        .results-table th:nth-child(5) { width: 70px; }  /* ?? */
        .results-table th:nth-child(6) { width: 70px; }  /* ?? */
        .results-table th:nth-child(7) { width: 120px; } /* ???? */
        .results-table th:nth-child(8) { width: 150px; } /* ?? */
        .results-table th:nth-child(9) { width: 80px; } /* ???? */
        .results-table th:nth-child(10) { width: 80px; } /* ?? */
        .results-table th:nth-child(11) { width: 100px; } /* ?? */
        
        .punch-report-cell {
            text-align: center;
            vertical-align: middle;
        }
        
        .punch-report-checkbox {
            margin-right: 8px;
        }
        
        .punch-report-select {
            font-size: 12px;
            padding: 4px 8px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            background: var(--bg-primary);
        }
        
        .idm-cell {
            font-family: 'Courier New', monospace;
            font-weight: 400;
        }
        
        .work-type {
            display: inline-block;
            padding: var(--spacing-xs) var(--spacing-sm);
            font-size: var(--font-size-sm);
            font-weight: 400;
            border: var(--border-width) solid var(--border-color);
            background: var(--bg-primary);
        }
        
        .attendance-times {
            font-family: 'Courier New', monospace;
            font-size: var(--font-size-sm);
        }
        
        .attendance-time {
            display: inline-block;
            padding: var(--spacing-xs) var(--spacing-sm);
            margin: 1px;
            font-weight: 400;
            border: var(--border-width) solid var(--border-color);
            background: var(--bg-secondary);
        }
        
        .attendance-time.valid-clock-in {
            background: var(--bg-primary);
            border-color: var(--accent-color);
        }
        
        .attendance-time.valid-clock-out {
            background: var(--bg-primary);
            border-color: var(--accent-color);
        }
        
        .no-attendance {
            color: var(--text-secondary);
            font-style: normal;
        }
        
        .alert-item {
            display: block;
            padding: var(--spacing-xs) var(--spacing-sm);
            margin: var(--spacing-xs) 0;
            font-size: var(--font-size-sm);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 300px;
            border: var(--border-width) solid var(--border-color);
            background: var(--bg-secondary);
        }
        
        /* ?????????? */
        .loading {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--spacing-lg);
            gap: var(--spacing-md);
        }
        
        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid var(--border-color);
            border-top-color: var(--accent-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
        
        .loading-text {
            color: var(--text-secondary);
            font-size: var(--font-size-md);
        }
    </style>
</head>
<body>
    <div class="container">
        <div style="margin-bottom: var(--spacing-md);">
            <a href="/" class="back-link">??????</a>
            <a href="/check" class="back-link" style="margin-left: var(--spacing-md);">??????</a>
            <a href="/admin" class="back-link" style="margin-left: var(--spacing-md);">????</a>
        </div>
        
        <h1>??????????</h1>
        
        <div class="search-form">
            <form id="search-form">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="section-select">?????</label>
                        <select id="section-select">
                            <option value="">?????????</option>
                        </select>
                        <small style="color: #666; font-size: 0.8em; margin-top: 3px;">
                            ??????????
                        </small>
                    </div>
                    <div class="form-group">
                        <label for="employee-id">???ID????</label>
                        <select id="employee-id" name="employee_id" required>
                            <option value="">? ?????????...</option>
                        </select>
                        <small id="employee-hint" style="color: #666; font-size: 0.8em; margin-top: 3px; display: none;">
                            ???????????????????
                        </small>
                    </div>
                    <div class="form-group">
                        <label for="search-month">????</label>
                        <input type="text" id="search-month" name="search_month" placeholder="?: 2025/12" value="" pattern="[0-9]{4}/[0-9]{1,2}" required>
                        <small style="color: #666; font-size: 0.8em; margin-top: 3px;">
                            yyyy/mm?????16?????15????
                        </small>
                    </div>
                </div>
                <div>
                    <button type="submit" class="btn btn-search">?? ??</button>
                    <button type="button" class="btn btn-clear" onclick="clearForm()">?? ???</button>
                </div>
            </form>
        </div>
        
        <div id="error-message" style="display: none;" class="error"></div>
        
        <div class="results-section" id="results-section" style="display: none;">
            <div class="results-header">
                <div class="results-count" id="results-count">??: 0 ?</div>
                <div id="punch-report-summary" style="margin: 10px 0; padding: 8px; background-color: #f8f9fa; border-left: 4px solid #007bff; border-radius: 4px; display: none;">
                    <small style="color: #495057;">
                        ?? ??????: <span id="punch-report-count" style="font-weight: bold; color: #007bff;">0?</span>
                        <button style="margin-left: 10px; font-size: 0.8em; padding: 2px 8px; background: #dc3545; color: white; border: none; border-radius: 3px; cursor: pointer;" 
                                onclick="clearAllPunchReports()" title="??????????">???</button>
                    </small>
                </div>
                <button class="btn-export" onclick="exportCSV()">CSV??</button>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>???ID</th>
                            <th>??</th>
                            <th>???</th>
                            <th>????</th>
                            <th>??</th>
                            <th>??</th>
                            <th>????</th>
                            <th>??</th>
                            <th>????</th>
                            <th>??</th>
                            <th>??</th>
                            <th>??</th>
                        </tr>
                    </thead>
                    <tbody id="results-body">
                    </tbody>
                </table>
            </div>
        </div>
        
        <div id="loading" class="loading" style="display: none;">
            <div class="spinner"></div>
            <span class="loading-text">???</span>
        </div>
        
        <div id="no-results" class="no-results" style="display: none;">
            ????????????????????????
        </div>


    </div>
    
    <!-- ??????? -->
    <script src="{{ url_for('static', filename='js/attendance-common.js') }}"></script>
    <script src="{{ url_for('static', filename='js/attendance-check.js') }}"></script>
    <script src="{{ url_for('static', filename='js/api-service.js') }}"></script>
    <script src="{{ url_for('static', filename='js/employee-list.js') }}"></script>
    
    <script>
        // ============================================
        // search.html ???JavaScript
        // ============================================
        
        // ??????????????????????????
        console.log('[search.html] ===== ??????? =====', new Date().toISOString());
        
        // ?????????????
        const DEBUG = true;
        function debugLog(...args) {
            console.log('[search.html]', new Date().toISOString(), ...args);
        }
        
        // ????????
        function debugError(...args) {
            console.error('[search.html ERROR]', new Date().toISOString(), ...args);
        }
        
        // ?????????
        debugLog('=== search.html ??????????? ===');
        
        // AttendanceSystem????????
        if (typeof AttendanceSystem === 'undefined') {
            console.error('[search.html ERROR] AttendanceSystem???????????attendance-common.js???????????????????');
            // ????????????
            window.AttendanceSystem = window.AttendanceSystem || {};
        }
        
        // ??????????????????????
        AttendanceSystem.Search = AttendanceSystem.Search || {};
        AttendanceSystem.Search.searchResults = [];
        
        // ????????
        // allEmployees?employee-list.js?????????????????????????????????
        // searchResults?AttendanceSystem.Search.searchResults??????let???????
        // allEmployees?employee-list.js??????????????????????
        
        debugLog('??????????');
        console.log('[search.html] AttendanceSystem??:', typeof AttendanceSystem !== 'undefined' ? 'OK' : 'NG');
        
        // ???????????????????
        function calculateCurrentPayrollMonth() {
            debugLog('calculateCurrentPayrollMonth() ????');
            const today = new Date();
            const year = today.getFullYear();
            const month = today.getMonth() + 1; // 0??????+1
            const day = today.getDate();
            
            // 16?????????15????????
            if (day >= 16) {
                // ???
                if (month === 12) {
                    return `${year + 1}/1`;
                } else {
                    return `${year}/${month + 1}`;
                }
            } else {
                // ???
                return `${year}/${month}`;
            }
        }

        // DOMContentLoaded???????????
        console.log('[search.html] DOMContentLoaded???????', new Date().toISOString());
        
        document.addEventListener('DOMContentLoaded', async function() {
            console.log('[search.html] ===== DOMContentLoaded ?????? =====', new Date().toISOString());
            debugLog('=== DOMContentLoaded ?????? ===');
            debugLog('???URL:', window.location.href);
            debugLog('URL?????:', window.location.search);
            
            try {
                // ????????????????API???????
                debugLog('????????????');
                await loadEmployees('employee-id', 'section-select', '????????????', function(employees) {
                    debugLog('???????????:', employees.length, '?');
                    debugLog('??????????:', employees.slice(0, 3));
                    // ?????????
                    const employeeHint = document.getElementById('employee-hint');
                    if (employeeHint) {
                        employeeHint.style.display = 'block';
                        employeeHint.textContent = `${employees.length}??????????????`;
                    }
                });
                
                // ??????????????????
                setupSectionChangeListener('employee-id', 'section-select', '????????????');
                debugLog('???????????????');
                
                // ???????????????????
                const currentMonth = calculateCurrentPayrollMonth();
                const monthInput = document.getElementById('search-month');
                if (monthInput) {
                    monthInput.value = currentMonth;
                    debugLog('??????:', currentMonth, '? ????:', monthInput.value);
                } else {
                    debugError('search-month??????????');
                }
                
                // URL??????????ID???
                const urlParams = new URLSearchParams(window.location.search);
                const employeeId = urlParams.get('employee_id');
                debugLog('URL???????????employee_id:', employeeId);
                debugLog('?URL?????:', Object.fromEntries(urlParams));
                
                if (employeeId) {
                    // ???ID???
                    const employeeSelect = document.getElementById('employee-id');
                    if (employeeSelect) {
                        employeeSelect.value = employeeId;
                        debugLog('???ID???:', employeeId, '? ????:', employeeSelect.value);
                        debugLog('??????????????:', employeeSelect.options.length);
                        
                        // ????????????????????
                        debugLog('????????URL????????');
                        await performSearch();
                    } else {
                        debugError('employee-id??????????');
                    }
                } else {
                    debugLog('URL??????employee_id??????');
                }
                
                debugLog('=== DOMContentLoaded ???? ===');
            } catch (error) {
                debugError('DOMContentLoaded???????:', error);
                console.error(error);
            }
        });
        
        // loadEmployees, updateEmployeeList, setupSectionChangeListener ? employee-list.js ????
        
        // ???????DOMContentLoaded?????
        console.log('[search.html] ?????????????', new Date().toISOString());
        
        // DOMContentLoaded????
        document.addEventListener('DOMContentLoaded', function() {
            const searchForm = document.getElementById('search-form');
            if (searchForm) {
                console.log('[search.html] ??????????????');
                searchForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    debugLog('??????????');
                    await performSearch();
                });
            } else {
                console.error('[search.html ERROR] search-form??????????');
            }
        });
        
        // ????
        async function performSearch() {
            debugLog('=== performSearch() ?? ===');
            
            try {
                // ?????????
                const employeeSelect = document.getElementById('employee-id');
                const monthInput = document.getElementById('search-month');
                
                if (!employeeSelect) {
                    debugError('employee-id??????????');
                    return;
                }
                if (!monthInput) {
                    debugError('search-month??????????');
                    return;
                }
                
                const employeeId = employeeSelect.value.trim();
                const searchMonth = monthInput.value.trim();
                
                debugLog('?????????????:');
                debugLog('  employee-id??:', employeeSelect);
                debugLog('  employee-id.value:', employeeId);
                debugLog('  employee-id.options.length:', employeeSelect.options.length);
                debugLog('  search-month.value:', searchMonth);
                debugLog('???????:', { employeeId, searchMonth });
                
                // ???????
                if (!employeeId) {
                    debugLog('??????????: ???ID???');
                    showError('???ID?????????');
                    return;
                }
                
                if (!searchMonth) {
                    debugLog('??????????: ?????');
                    showError('??????????????yyyy/mm???');
                    return;
                }
                
                // ????????????
                const monthPattern = /^[0-9]{4}\/[0-9]{1,2}$/;
                if (!monthPattern.test(searchMonth)) {
                    debugLog('??????????: ?????', searchMonth);
                    showError('???yyyy/mm?????????????: 2025/10?');
                    return;
                }
                
                debugLog('? ?????????');
                
                // UI????
                document.getElementById('results-section').style.display = 'none';
                document.getElementById('no-results').style.display = 'none';
                document.getElementById('error-message').style.display = 'none';
                document.getElementById('loading').style.display = 'block';
                
                // ??????????
                const params = new URLSearchParams();
                params.append('employee_id', employeeId);
                params.append('search_month', searchMonth);
                
                const searchUrl = `/api/search?${params}`;
                debugLog('?? API?????URL:', searchUrl);
                debugLog('?? ??????????:', {
                    employee_id: params.get('employee_id'),
                    search_month: params.get('search_month')
                });

                try {
                    debugLog('?? API?????????');
                    const requestStartTime = Date.now();
                    const response = await fetch(searchUrl);
                    const requestEndTime = Date.now();
                    const requestDuration = requestEndTime - requestStartTime;
                    
                    debugLog('?? API???????:', {
                        status: response.status,
                        statusText: response.statusText,
                        ok: response.ok,
                        duration: `${requestDuration}ms`
                    });
                    
                    const data = await response.json();
                    debugLog('?? API????????:', {
                        status: data.status,
                        results_count: data.results ? data.results.length : 0,
                        search_params: data.search_params,
                        full_data: data
                    });

                    // ?????? displayResults ?????????
                    // document.getElementById('loading').style.display = 'none';

                    if (data.status === 'success') {
                        AttendanceSystem.Search.searchResults = data.results;
                        debugLog('? ????:', AttendanceSystem.Search.searchResults.length, '?');
                        
                        // ???????????????
                        const totalAlerts = data.results.reduce((sum, item) => {
                            const alertCount = item.alerts ? item.alerts.length : 0;
                            return sum + alertCount;
                        }, 0);
                        debugLog('?? ??????:', totalAlerts);
                        debugLog('?? ????????????3??:', data.results.slice(0, 3));

                        await displayResults(data.results, data.search_params);
                        
                        // ????????????????????
                        document.getElementById('loading').style.display = 'none';

                    } else {
                        // ?????????????????
                        document.getElementById('loading').style.display = 'none';
                        debugError('API???:', data.message || '??????');
                        showError(data.message || '?????????');
                    }
                } catch (error) {
                    // ?????????????????
                    document.getElementById('loading').style.display = 'none';
                    debugError('? API????????:', error);
                    debugError('?????:', {
                        message: error.message,
                        stack: error.stack,
                        name: error.name
                    });
                    showError('??????????????: ' + error.message);
                }
            } catch (error) {
                debugError('? performSearch()???????:', error);
                console.error(error);
            }
            
            debugLog('=== performSearch() ?? ===');
        }
        
        // ???????
        async function displayResults(results, searchParams) {
            debugLog('displayResults() ??:', results.length, '?');
            
            if (results.length === 0) {
                debugLog('?????0?');
                document.getElementById('loading').style.display = 'none';
                document.getElementById('no-results').style.display = 'block';
                return;
            }

            // ????????????
            results.sort((a, b) => {
                const dateA = new Date(a.work_date);
                const dateB = new Date(b.work_date);
                return dateA - dateB;
            });
            debugLog('??????????');

            // 24??????????????????????
            results = processNightShiftEndTimes(results);
            debugLog('24?????');
            
            const tbody = document.getElementById('results-body');
            tbody.innerHTML = '';
            
            debugLog('??????????');
            results.forEach((item, index) => {
                debugLog(`?${index + 1}???:`, item.work_date);
                
                const tr = document.createElement('tr');
                // ?????????????????????????????
                // ????????????
                if (item.work_type) {
                    item.work_type = item.work_type.replace('?', '?');
                }
                const attendanceTimesHtml = formatAttendanceTimes(item.attendance_records || [], item.work_type, item.work_date, results);
                
                // ID???????????????????????item.id, item.sheet_number?
                // ????????????????????
                const alerts = item.alerts || [];
                const alertsHtml = formatAlertsWithOvertimeCheck(item, alerts);
                
                // ????HTML???
                const alertMessages = alerts.map(alert => typeof alert === 'string' ? alert : alert.message || alert.details || '');
                const punchReportHtml = generatePunchReportCell(item, alertMessages);
                
                // ??????HTML??????????????
                const checkStatusHtml = generateCheckStatusHTML(item, alerts);
                
                tr.innerHTML = `
                    <td class="idm-cell">${item.employee_id}</td>
                    <td><strong>${item.employee_name || ''}</strong></td>
                    <td>${formatDate(item.work_date)}</td>
                    <td><span class="work-type ${getWorkTypeClass(item.work_type)}">${item.work_type || ''}</span></td>
                    <td>${formatTime(item.start_time)}</td>
                    <td>${formatEndTime(item)}</td>
                    <td class="attendance-times">${attendanceTimesHtml}</td>
                    <td id="alerts-${item.work_date}" style="font-size: 0.85em;">${alertsHtml}</td>
                    <td id="check-status-${item.employee_id}-${item.work_date}" style="font-size: 0.85em;">${checkStatusHtml}</td>
                    <td id="overtime-${item.work_date}" style="font-size: 0.85em; color: #667eea;">-</td>
                    <td id="leave-${item.work_date}" style="font-size: 0.85em; color: #28a745;">-</td>
                    <td class="punch-report-cell">${punchReportHtml}</td>
                `;
                // ???????????????????
                tr.dataset.fullData = JSON.stringify(item);
                tbody.appendChild(tr);
            });
            debugLog('??????????');
            
            // ??????????????????????
            await loadCheckStatuses(results);
            
            // ?????????????????
            const employeeId = searchParams.employee_id;
            debugLog('???????????????:', employeeId);
            fetchOvertimeDataForMonth(employeeId, results).then(() => {
                // ????????????????????????????????
                refreshTimeDiffAlerts(results);
                // ???????????
                restoreTimeDiffConfirmations(results);
            });
            fetchLeaveDataForMonth(employeeId, results);
            
            // ??????????
            let rangeInfo = '';
            if (searchParams && searchParams.date_range) {
                rangeInfo = ` (${searchParams.date_range.start_date} ?? ${searchParams.date_range.end_date})`;
            }
            
            document.getElementById('results-count').textContent = `??: ${results.length} ?${rangeInfo}`;
            document.getElementById('results-section').style.display = 'block';
            
            // ??????????
            restorePunchReportData(results);
            
            // ????????????????????
            document.getElementById('loading').style.display = 'none';
            debugLog('displayResults() ??');
        }
        
        // ??????????
        function restorePunchReportData(results) {
            debugLog('restorePunchReportData() ??');
            results.forEach(item => {
                const employeeId = item.employee_id;
                const workDate = item.work_date;
                
                ['checkin', 'checkout'].forEach(punchType => {
                    const key = `punch_report_${employeeId}_${workDate}_${punchType}`;
                    const stored = localStorage.getItem(key);
                    if (stored) {
                        const checkbox = document.querySelector(`input[data-employee="${employeeId}"][data-date="${workDate}"][data-type="${punchType}"]`);
                        if (checkbox) {
                            checkbox.checked = true;
                            debugLog('??????????:', key);
                        }
                    }
                });
            });
            updatePunchReportSummary();
            debugLog('restorePunchReportData() ??');
        }
        
        // ???????????????????????
        async function refreshTimeDiffAlerts(results) {
            debugLog('refreshTimeDiffAlerts() ??');
            
            // ??????????????????????????????
            const promises = results.map(async (item) => {
                const alerts = item.alerts || [];
                const hasClockInTimeDiff = alerts.some(alert => {
                    const alertStr = typeof alert === 'string' ? alert : (alert.message || alert.details || '');
                    return alertStr.includes('?????????');
                });
                
                if (hasClockInTimeDiff) {
                    try {
                        // ???????????????
                        const response = await AttendanceSystem.API.Check.getStatus(
                            item.employee_id,
                            item.work_date,
                            CheckType.TIME_DIFFERENCE
                        );
                        
                        // ?????item????formatAlertsWithOvertimeCheck????
                        if (response.success && response.data && response.data.is_checked) {
                            const notes = response.data.notes || '';
                            item._timeDiffChecked = notes.includes('????');
                        } else {
                            item._timeDiffChecked = false;
                        }
                        
                        const alertsCell = document.getElementById(`alerts-${item.work_date}`);
                        if (alertsCell) {
                            const newAlertsHtml = formatAlertsWithOvertimeCheck(item, alerts);
                            alertsCell.innerHTML = newAlertsHtml;
                            debugLog('????????????:', item.work_date);
                        }
                    } catch (error) {
                        console.error(`[refreshTimeDiffAlerts] ??? (${item.work_date}):`, error);
                    }
                }
            });
            
            await Promise.all(promises);
            debugLog('refreshTimeDiffAlerts() ??');
        }
        
        // ???????????????????????
        async function restoreTimeDiffConfirmations(results) {
            debugLog('restoreTimeDiffConfirmations() ??');
            
            // ???????????????????????
            const promises = results.map(async (item) => {
                const employeeId = item.employee_id;
                const workDate = item.work_date;
                
                try {
                    const response = await AttendanceSystem.API.Check.getStatus(
                        employeeId,
                        workDate,
                        CheckType.TIME_DIFFERENCE
                    );
                    
                    if (response.success && response.data && response.data.is_checked) {
                        // notes??????????????????
                        const notes = response.data.notes || '';
                        if (notes.includes('?????')) {
                            const checkbox = document.getElementById(`no-overtime-${employeeId}-${workDate}`);
                            if (checkbox) {
                                checkbox.checked = true;
                                updateTimeDiffConfirmationDisplay(employeeId, workDate, true);
                                debugLog('???????????:', { employeeId, workDate });
                            }
                        }
                    }
                } catch (error) {
                    console.error(`[restoreTimeDiffConfirmations] ??? (${employeeId}, ${workDate}):`, error);
                }
            });
            
            await Promise.all(promises);
            debugLog('restoreTimeDiffConfirmations() ??');
        }

        // ???????????
        function updatePunchReportSummary() {
            const allKeys = Object.keys(localStorage).filter(key => key.startsWith('punch_report_'));
            const summaryDiv = document.getElementById('punch-report-summary');
            const countSpan = document.getElementById('punch-report-count');
            
            if (allKeys.length > 0) {
                countSpan.textContent = `${allKeys.length}?`;
                summaryDiv.style.display = 'block';
            } else {
                summaryDiv.style.display = 'none';
            }
        }

        // ????????????
        function clearAllPunchReports() {
            if (!confirm('?????????????????')) {
                return;
            }
            
            const allKeys = Object.keys(localStorage).filter(key => key.startsWith('punch_report_'));
            allKeys.forEach(key => localStorage.removeItem(key));
            
            // ?????????????
            const checkboxes = document.querySelectorAll('.punch-report-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = false;
            });
            
            // ????????
            const rows = document.querySelectorAll('#results-body tr');
            rows.forEach(row => {
                row.style.backgroundColor = '';
            });
            
            updatePunchReportSummary();
        }

        // ??????????
        function getFullDataFromRow(row) {
            const fullDataStr = row.dataset.fullData;
            if (fullDataStr) {
                return JSON.parse(fullDataStr);
            }
            return null;
        }

        // ???????????
        function getAllRowData() {
            const rows = document.querySelectorAll('#results-body tr');
            return Array.from(rows).map(row => getFullDataFromRow(row)).filter(data => data !== null);
        }

        // ?????????
        function formatDateTime(datetime) {
            if (!datetime) return '';
            const dt = new Date(datetime);
            return dt.toLocaleString('ja-JP');
        }

        // ???????????
        function showError(message) {
            debugLog('showError() ????:', message);
            const errorDiv = document.getElementById('error-message');
            errorDiv.textContent = message;
            errorDiv.style.display = 'block';
        }

        // ????????
        function clearForm() {
            debugLog('clearForm() ????');
            document.getElementById('employee-id').value = '';
            document.getElementById('search-month').value = calculateCurrentPayrollMonth();
            document.getElementById('results-section').style.display = 'none';
            document.getElementById('no-results').style.display = 'none';
            document.getElementById('error-message').style.display = 'none';
        }
        
        // ???????????????
        async function fetchOvertimeDataForMonth(employeeId, results) {
            debugLog('fetchOvertimeDataForMonth() ??:', employeeId);
            try {
                const response = await fetch(`/api/overtime?employee_num=${employeeId}&limit=1000`);
                const result = await response.json();
                
                if (result.status === 'success' && result.data) {
                    debugLog('??????????:', result.data.length, '?');
                    result.data.forEach(overtime => {
                        const cell = document.getElementById(`overtime-${overtime.work_date}`);
                        if (cell) {
                            const totalMin = (overtime.inner_overtime_minutes || 0) + (overtime.outer_overtime_minutes || 0);
                            const hours = (totalMin / 60).toFixed(1);
                            cell.innerHTML = `${overtime.start_time}-${overtime.end_time}<br><small>(${hours}h)</small>`;
                        }
                    });
                }
                return Promise.resolve();
            } catch (error) {
                debugLog('???????????:', error);
                console.error('[???????????]', error);
                return Promise.reject(error);
            }
        }
        
        // ?????????????
        async function fetchLeaveDataForMonth(employeeId, results) {
            debugLog('fetchLeaveDataForMonth() ??:', employeeId);
            try {
                const response = await fetch(`/api/leave?employee_num=${employeeId}&limit=1000`);
                const result = await response.json();
                
                if (result.status === 'success' && result.data) {
                    debugLog('??????????:', result.data.length, '?');
                    result.data.forEach(leave => {
                        // ?????????????
                        const startDate = new Date(leave.leave_date_from);
                        const endDate = new Date(leave.leave_date_to);
                        
                        for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
                            const dateStr = d.toISOString().split('T')[0];
                            const cell = document.getElementById(`leave-${dateStr}`);
                            if (cell) {
                                let detail = leave.leave_type;
                                if (leave.leave_subtype) {
                                    detail = leave.leave_subtype.substring(0, 20);
                                }
                                cell.innerHTML = `${detail}`;
                            }
                        }
                    });
                }
            } catch (error) {
                debugLog('???????????:', error);
                console.error('[???????????]', error);
            }
        }
        
        // ????????????????????????????
        function formatAlertsWithOvertimeCheck(item, alerts) {
            const workDate = item.work_date;
            const employeeId = item.employee_id;
            
            // ??????????????
            let alertsHtml = formatAlerts(alerts);
            
            // ???????????????????????????
            const hasPunchLeak = alerts.some(a => (a.message || '').includes('????'));
            const hasMissingPunch = alerts.some(a => (a.message || '').includes('????'));
            
            let checkboxesHtml = '';
            if (hasPunchLeak) {
                checkboxesHtml += `
                    <div style="display: flex; align-items: center; gap: 5px; margin-top: 3px;">
                        <input type="checkbox" 
                               id="alert-check-punchleak-${employeeId}-${workDate}" 
                               data-type="${CheckType.PUNCH_LEAK}"
                               data-employee="${employeeId}"
                               data-date="${workDate}"
                               style="margin: 0; cursor: pointer;"
                               onchange="updateCheckStatus(this)">
                        <label for="alert-check-punchleak-${employeeId}-${workDate}" 
                               style="font-size: 0.85em; cursor: pointer; margin: 0;">
                            ??????
                        </label>
                    </div>
                `;
            }
            
            if (hasMissingPunch) {
                checkboxesHtml += `
                    <div style="display: flex; align-items: center; gap: 5px; margin-top: 3px;">
                        <input type="checkbox" 
                               id="alert-check-missing-${employeeId}-${workDate}" 
                               data-type="${CheckType.MISSING_PUNCH}"
                               data-employee="${employeeId}"
                               data-date="${workDate}"
                               style="margin: 0; cursor: pointer;"
                               onchange="updateCheckStatus(this)">
                        <label for="alert-check-missing-${employeeId}-${workDate}" 
                               style="font-size: 0.85em; cursor: pointer; margin: 0;">
                            ??????????
                        </label>
                    </div>
                `;
            }
            
            // ????????????????????
            const hasClockInTimeDiff = alerts.some(alert => {
                const alertStr = typeof alert === 'string' ? alert : (alert.message || alert.details || '');
                return alertStr.includes('?????????');
            });
            
            if (hasClockInTimeDiff) {
                // ??????????????????????????????
                const overtimeCell = document.getElementById(`overtime-${workDate}`);
                const hasOvertime = overtimeCell && overtimeCell.textContent.trim() !== '-' && !overtimeCell.textContent.includes('????');
                
                // ?????????????????????
                // item._timeDiffChecked?refreshTimeDiffAlerts??????
                const isNoOvertimeConfirmed = item._timeDiffChecked === true;
                
                if (!hasOvertime && !isNoOvertimeConfirmed) {
                    // ?????????????????????????
                    alertsHtml += `
                        <div class="alert-item info" style="margin-top: 5px; padding: 5px; background: #e7f3ff; border: 1px solid #b3d9ff;">
                            <div style="display: flex; align-items: center; gap: 5px; flex-wrap: wrap;">
                                <span style="font-size: 0.85em;">??????</span>
                                <label style="display: flex; align-items: center; gap: 3px; font-size: 0.75em; cursor: pointer; margin-left: 5px;">
                                    <input type="checkbox" 
                                           id="no-overtime-${employeeId}-${workDate}" 
                                           class="no-overtime-checkbox" 
                                           data-employee="${employeeId}" 
                                           data-date="${workDate}"
                                           style="margin: 0;"
                                           onchange="handleNoOvertimeChange(this)">
                                    <span>????</span>
                                </label>
                                <button type="button" 
                                        class="btn btn-info" 
                                        style="font-size: 0.75em; padding: 2px 8px; margin-left: 5px;"
                                        onclick="window.location.href='/overtime?employee_id=${employeeId}&work_date=${workDate}'">
                                    ????
                                </button>
                            </div>
                        </div>
                    `;
                } else if (isNoOvertimeConfirmed) {
                    // ???????????????
                    alertsHtml += `
                        <div style="margin-top: 5px; font-size: 0.7em; color: #28a745;">
                            ? ????????
                        </div>
                    `;
                }
            }
            
            return alertsHtml;
        }
        
        // ???????????????????????
        async function handleNoOvertimeChange(checkbox) {
            const employeeId = checkbox.dataset.employee;
            const workDate = checkbox.dataset.date;
            const isChecked = checkbox.checked;
            
            debugLog('handleNoOvertimeChange()', { employeeId, workDate, isChecked });
            
            try {
                // ?????????/??
                const response = await AttendanceSystem.API.Check.updateStatus({
                    employee_num: employeeId,
                    work_date: workDate,
                    check_type: CheckType.TIME_DIFFERENCE,
                    is_checked: isChecked,
                    notes: isChecked ? '????' : null
                });
                
                if (response.success) {
                    debugLog('??????????????????:', { employeeId, workDate, isChecked });
                    
                    if (isChecked) {
                        // ??????????????????
                        removeClockInTimeDiffAlert(employeeId, workDate);
                        
                        // ??????????????????????????????????
                        updateTimeDiffConfirmationDisplay(employeeId, workDate, true);
                    } else {
                        // ????????
                        restoreClockInTimeDiffAlert(employeeId, workDate);
                        
                        // ????????????????
                        updateTimeDiffConfirmationDisplay(employeeId, workDate, false);
                    }
                } else {
                    console.error('[handleNoOvertimeChange] API???:', response.message);
                    // ??????????????????
                    checkbox.checked = !isChecked;
                    alert('?????????: ' + (response.message || '??????'));
                }
            } catch (error) {
                console.error('[handleNoOvertimeChange] ???:', error);
                // ??????????????????
                checkbox.checked = !isChecked;
                alert('?????????: ' + error.message);
            }
        }
        
        // ??????????????????
        function removeClockInTimeDiffAlert(employeeId, workDate) {
            const alertsCell = document.getElementById(`alerts-${workDate}`);
            if (!alertsCell) return;
            
            const alertItems = alertsCell.querySelectorAll('.alert-item');
            alertItems.forEach(alertItem => {
                const alertText = alertItem.textContent || '';
                if (alertText.includes('??????')) {
                    alertItem.remove();
                    debugLog('?????????????:', workDate);
                }
            });
        }
        
        // ???????????????????
        function restoreClockInTimeDiffAlert(employeeId, workDate) {
            const row = document.querySelector(`tr[data-full-data*="${workDate}"]`);
            if (!row) return;
            
            const fullDataStr = row.dataset.fullData;
            if (!fullDataStr) return;
            
            const item = JSON.parse(fullDataStr);
            const alerts = item.alerts || [];
            
            // ????????
            const alertsHtml = formatAlertsWithOvertimeCheck(item, alerts);
            const alertsCell = document.getElementById(`alerts-${workDate}`);
            if (alertsCell) {
                alertsCell.innerHTML = alertsHtml;
            }
        }
        
        // ????????????
        function updateTimeDiffConfirmationDisplay(employeeId, workDate, isConfirmed) {
            const alertsCell = document.getElementById(`alerts-${workDate}`);
            if (!alertsCell) return;
            
            const noOvertimeCheckbox = document.getElementById(`no-overtime-${employeeId}-${workDate}`);
            const overtimeButton = alertsCell.querySelector(`button[onclick*="${workDate}"]`);
            
            if (isConfirmed) {
                // ????????????????
                if (noOvertimeCheckbox) {
                    const label = noOvertimeCheckbox.closest('label');
                    if (label) label.style.display = 'none';
                }
                if (overtimeButton) {
                    overtimeButton.style.display = 'none';
                }
                
                // ?????????????????????????
                if (!alertsCell.querySelector('.time-diff-confirmed')) {
                    const confirmedMsg = document.createElement('div');
                    confirmedMsg.className = 'time-diff-confirmed';
                    confirmedMsg.style.cssText = 'margin-top: 5px; font-size: 0.7em; color: #28a745;';
                    confirmedMsg.textContent = '? ????????';
                    alertsCell.appendChild(confirmedMsg);
                }
            } else {
                // ????????????????
                if (noOvertimeCheckbox) {
                    const label = noOvertimeCheckbox.closest('label');
                    if (label) label.style.display = '';
                }
                if (overtimeButton) {
                    overtimeButton.style.display = '';
                }
                
                // ??????????????
                const confirmedMsg = alertsCell.querySelector('.time-diff-confirmed');
                if (confirmedMsg) {
                    confirmedMsg.remove();
                }
            }
        }
        
        // ?????????
        function generatePunchReportCell(item, alerts) {
            const workDate = item.work_date;
            const employeeId = item.employee_id;
            
            // ?????????????????????????
            // ????????????????????????????
            const checkinAlerts = alerts.filter(alert => {
                const alertStr = typeof alert === 'string' ? alert : (alert.message || alert.details || '');
                return alertStr.includes('??????');
            });
            
            const checkoutAlerts = alerts.filter(alert => {
                const alertStr = typeof alert === 'string' ? alert : (alert.message || alert.details || '');
                return alertStr.includes('??????');
            });
            
            const hasCheckinAlert = checkinAlerts.length > 0;
            const hasCheckoutAlert = checkoutAlerts.length > 0;
            
            if (!hasCheckinAlert && !hasCheckoutAlert) {
                return '<span style="color: #999; font-size: 0.8em;">????</span>';
            }
            
            // localStorage????????????
            const checkinKey = `punch_report_${employeeId}_${workDate}_checkin`;
            const checkoutKey = `punch_report_${employeeId}_${workDate}_checkout`;
            const hasCheckinReport = localStorage.getItem(checkinKey) !== null;
            const hasCheckoutReport = localStorage.getItem(checkoutKey) !== null;
            
            // ??????????????????
            const checkinDisplay = (hasCheckinAlert && !hasCheckinReport) ? '' : 'display: none;';
            const checkoutDisplay = (hasCheckoutAlert && !hasCheckoutReport) ? '' : 'display: none;';
            
            // ??????????????????
            if (checkinDisplay.includes('none') && checkoutDisplay.includes('none')) {
                return '<span style="color: #999; font-size: 0.8em;">????</span>';
            }
            
            return `
                <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
                    ${hasCheckinAlert ? `
                    <label style="display: flex; align-items: center; gap: 3px; font-size: 0.8em; cursor: pointer; ${checkinDisplay}">
                        <input type="checkbox" 
                               id="punch-leak-checkin-${employeeId}-${workDate}" 
                               class="punch-report-checkbox" 
                               data-employee="${employeeId}" 
                               data-date="${workDate}" 
                               data-type="checkin"
                               style="margin: 0;"
                               ${hasCheckinReport ? 'checked' : ''}
                               onchange="handlePunchReportChange(this)">
                        <span style="color: #dc3545;">?</span>
                    </label>
                    ` : ''}
                    ${hasCheckoutAlert ? `
                    <label style="display: flex; align-items: center; gap: 3px; font-size: 0.8em; cursor: pointer; ${checkoutDisplay}">
                        <input type="checkbox" 
                               id="punch-leak-checkout-${employeeId}-${workDate}" 
                               class="punch-report-checkbox" 
                               data-employee="${employeeId}" 
                               data-date="${workDate}" 
                               data-type="checkout"
                               style="margin: 0;"
                               ${hasCheckoutReport ? 'checked' : ''}
                               onchange="handlePunchReportChange(this)">
                        <span style="color: #28a745;">??</span>
                    </label>
                    ` : ''}
                </div>
            `;
        }

        // ????????????????????
        function handlePunchReportChange(checkbox) {
            const employeeId = checkbox.dataset.employee;
            const workDate = checkbox.dataset.date;
            const punchType = checkbox.dataset.type;
            const isChecked = checkbox.checked;
            
            debugLog('handlePunchReportChange()', { employeeId, workDate, punchType, isChecked });

            
            // ?????????????API????
            if (isChecked) {
                savePunchReport(employeeId, workDate, punchType);
                // ?????????????????
                removeAlertForPunchReport(employeeId, workDate, punchType);
                // ???????????????
                hideCheckboxForPunchReport(employeeId, workDate, punchType);
            } else {
                removePunchReport(employeeId, workDate, punchType);
                // ???????????????????????
                restoreAlertForPunchReport(employeeId, workDate, punchType);
                // ????????????
                showCheckboxForPunchReport(employeeId, workDate, punchType);
            }
        }
        
        // ??????????????????????
        function removeAlertForPunchReport(employeeId, workDate, punchType) {
            const alertsCell = document.getElementById(`alerts-${workDate}`);
            if (!alertsCell) return;
            
            // ????????????
            const alertItems = alertsCell.querySelectorAll('.alert-item');
            let hasChanges = false;
            
            alertItems.forEach(alertItem => {
                const alertText = alertItem.textContent || '';
                // ???????????????????????????????????????
                if (punchType === 'checkin' && alertText.includes('??????')) {
                    alertItem.remove();
                    hasChanges = true;
                    debugLog('?????????????:', workDate);
                }
                // ???????????????????????????????????????
                if (punchType === 'checkout' && alertText.includes('??????')) {
                    alertItem.remove();
                    hasChanges = true;
                    debugLog('?????????????:', workDate);
                }
            });
            
            // ?????????????????
            if (hasChanges && alertsCell.querySelectorAll('.alert-item').length === 0) {
                alertsCell.innerHTML = '<span style="color: #999; font-size: 0.8em;">??</span>';
            }
        }
        
        // ????????????????????
        function hideCheckboxForPunchReport(employeeId, workDate, punchType) {
            const checkboxId = `punch-leak-${punchType}-${employeeId}-${workDate}`;
            const checkbox = document.getElementById(checkboxId);
            if (checkbox) {
                const label = checkbox.closest('label');
                if (label) {
                    label.style.display = 'none';
                    debugLog('????????????:', checkboxId);
                }
            }
            
            // ???????????????????????????????????
            const punchReportCell = checkbox?.closest('.punch-report-cell');
            if (punchReportCell) {
                const visibleCheckboxes = punchReportCell.querySelectorAll('label[style*="display: none"]');
                const allCheckboxes = punchReportCell.querySelectorAll('label');
                if (allCheckboxes.length > 0 && visibleCheckboxes.length === allCheckboxes.length) {
                    punchReportCell.innerHTML = '<span style="color: #999; font-size: 0.8em;">????</span>';
                }
            }
        }
        
        // ???????????????????????
        function restoreAlertForPunchReport(employeeId, workDate, punchType) {
            // ????????
            const row = document.querySelector(`tr[data-full-data*="${workDate}"]`);
            if (!row) return;
            
            const fullDataStr = row.dataset.fullData;
            if (!fullDataStr) return;
            
            const item = JSON.parse(fullDataStr);
            const alerts = item.alerts || [];
            
            // ????????
            const alertsHtml = formatAlerts(alerts);
            const alertsCell = document.getElementById(`alerts-${workDate}`);
            if (alertsCell) {
                alertsCell.innerHTML = alertsHtml;
            }
        }
        
        // ????????????
        function showCheckboxForPunchReport(employeeId, workDate, punchType) {
            const checkboxId = `punch-leak-${punchType}-${employeeId}-${workDate}`;
            const checkbox = document.getElementById(checkboxId);
            if (checkbox) {
                const label = checkbox.closest('label');
                if (label) {
                    label.style.display = '';
                    debugLog('????????????:', checkboxId);
                }
            }
        }

        // ??????????
        function savePunchReport(employeeId, workDate, punchType) {
            // ????????????????
            const key = `punch_report_${employeeId}_${workDate}_${punchType}`;
            localStorage.setItem(key, JSON.stringify({
                employeeId: employeeId,
                workDate: workDate,
                punchType: punchType,
                reportedAt: new Date().toISOString(),
                status: 'reported'
            }));
            
            debugLog('??????????:', key);
            
            // ?????API???
            // submitPunchReportToAPI(employeeId, workDate, punchType);
            

            updateRowBackgroundForPunchReport(employeeId, workDate);
            updatePunchReportSummary();
        }

        // ??????????
        function removePunchReport(employeeId, workDate, punchType) {
            const key = `punch_report_${employeeId}_${workDate}_${punchType}`;
            localStorage.removeItem(key);
            
            debugLog('??????????:', key);

            updateRowBackgroundForPunchReport(employeeId, workDate);
            updatePunchReportSummary();
        }

        // ??????
        function updateRowBackgroundForPunchReport(employeeId, workDate) {
            // ???????????????????
            const hasAnyReport = ['checkin', 'checkout'].some(type => {
                const key = `punch_report_${employeeId}_${workDate}_${type}`;
                return localStorage.getItem(key) !== null;
            });
            
            // ????????????????
            const rows = document.querySelectorAll('#results-body tr');
            rows.forEach(row => {
                const cells = row.cells;
                if (cells.length > 2) {
                    const rowEmployeeId = cells[0].textContent.trim();
                    const rowDate = cells[2].textContent.trim();
                    if (rowEmployeeId === employeeId && rowDate === formatDate(workDate)) {
                        row.style.backgroundColor = hasAnyReport ? '#fff3cd' : '';
                    }
                }
            });
        }

        // CSV??
        function exportCSV() {
            debugLog('exportCSV() ????');
            if (AttendanceSystem.Search.searchResults.length === 0) {
                alert('??????????');
                return;
            }
            
            let csv = '???ID,??,??,????,??,??,????,??\n';
            AttendanceSystem.Search.searchResults.forEach(item => {
                const attendanceTimes = (item.attendance_records || []).map(record => record.time_only).join(' ');
                
                // ????????24?????????????24??????????
                let endTimeForCSV = '';
                if (item.work_type === '?' && item.night_shift_end_time) {
                    // ?????24???????
                    endTimeForCSV = `${item.night_shift_end_time} (${item.night_shift_work_type}?)`;
                } else if (item.work_type && item.work_type.includes('24?')) {
                    // 24???????
                    endTimeForCSV = '????';
                } else {
                    // ??
                    endTimeForCSV = item.end_time || '';
                }
                
                // ???????CSV???
                const alertsText = (item.alerts || []).map(alert => {
                    return alert.details ? `${alert.message}: ${alert.details}` : alert.message;
                }).join('; ').replace(/"/g, '""');
                
                // CSV????????????????
                let csvWorkType = item.work_type || '';
                csvWorkType = csvWorkType.replace('?', '?');
                csv += `"${item.employee_id}","${item.employee_name || ''}","${item.work_date}","${csvWorkType}","${item.start_time || ''}","${endTimeForCSV}","${attendanceTimes}","${alertsText}"\n`;
            });
            
            // BOM?Byte Order Mark??????Excel????????
            const BOM = '\uFEFF';
            const blob = new Blob([BOM + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `schedule_${new Date().toISOString().slice(0, 10)}.csv`;
            link.click();
            
            debugLog('CSV????');
        }
    </script>
</body>
